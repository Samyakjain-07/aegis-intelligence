# Copy to frontend/.env.local (gitignored by Vite's default .gitignore
# pattern for *.local) and adjust if services/api isn't running on its
# default PROJECT_HANDBOOK.md port/prefix.

# Base URL of services/api's v1 router. Falls back to this same value in
# code (src/app/lib/api.ts) if unset, so setting this is only needed when
# the API isn't reachable at localhost:8001. Port 8001, not uvicorn's own
# default of 8000 -- 8000 is permanently occupied on this dev machine by
# an unrelated local project's Docker container; see docs/DECISIONS_LOG.md.
# Run the API with: uvicorn src.main:app --reload --port 8001
VITE_API_BASE_URL=http://localhost:8001/api/v1
