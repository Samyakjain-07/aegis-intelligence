# Aegis Intelligence — production / staging environment variables
#
# Companion to the repo-root `.env.example` (local dev, local Docker
# containers) — this file documents the variables `docker-compose.prod.yml`
# expects to be pointed at MANAGED services (Qdrant Cloud, RDS/Cloud SQL,
# managed Redis — PROJECT_HANDBOOK.md §7's "Managed services checklist"),
# not the local `postgres`/`qdrant`/`redis` containers `docker-compose.yml`
# runs. Copy to `.env.prod`, fill in real values. `.env.prod` matches the
# repo-root `.env.*` gitignore pattern — never commit real values here.
#
# In real staging/prod, these are never read from a file at all — they're
# injected as GitHub Actions secrets (CI/CD) or the deploy target's own
# secret manager (see infra/terraform's ECS task definitions), per
# PROJECT_HANDBOOK.md §7. This file exists for the one case that DOES read
# it: running `docker compose -f docker-compose.prod.yml up` locally as a
# prod-like smoke test (Phase 9's own Definition of Done).
#
# LOCAL SMOKE TEST NOTE: to smoke-test docker-compose.prod.yml against
# your EXISTING local docker-compose.yml containers (rather than real
# managed endpoints you may not have provisioned yet), point these at
# `host.docker.internal` instead of `localhost` — a container can't reach
# the host machine's `localhost`, but Docker Desktop resolves
# `host.docker.internal` to it. Example values for that path are given
# below, commented out, alongside the "real managed endpoint" shape.

# --- Postgres (managed: RDS / Cloud SQL) ---
# Real managed shape:
# DATABASE_URL=postgresql+psycopg2://aegis_prod:REPLACE_ME@aegis-prod.xxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/aegis
# Local smoke-test shape (reuses docker-compose.yml's local postgres):
# DATABASE_URL=postgresql+psycopg2://changeme:changeme@host.docker.internal:5432/aegis
DATABASE_URL=changeme

# --- Qdrant (managed: Qdrant Cloud) ---
# Real managed shape (Qdrant Cloud clusters are HTTPS + API-key
# authenticated, unlike the local unauthenticated container):
# QDRANT_URL=https://xxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=REPLACE_ME
# Local smoke-test shape (reuses docker-compose.yml's local qdrant, host
# port 6335 — see that file's own comments for why it's not 6333):
# QDRANT_URL=http://host.docker.internal:6335
QDRANT_URL=changeme
QDRANT_API_KEY=

# --- Redis (managed: ElastiCache / Cloud Memorystore) ---
# Real managed shape (TLS-enabled managed Redis uses rediss://, not redis://):
# REDIS_URL=rediss://aegis-prod.xxxxxx.ng.0001.use1.cache.amazonaws.com:6379/0
# Local smoke-test shape:
# REDIS_URL=redis://host.docker.internal:6379/0
REDIS_URL=changeme

# --- CORS ---
# The real deployed frontend origin(s), comma-separated — src/main.py's
# own default only covers local Vite dev ports.
CORS_ALLOWED_ORIGINS=https://REPLACE_ME.example.com

# --- Cohere / OpenAI (same two vendors as local dev, see .env.example) ---
COHERE_API_KEY=changeme
OPENAI_API_KEY=changeme

# --- LangSmith tracing (optional, see .env.example) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aegis-intelligence-staging

# --- File storage ---
# Local-disk storage (services/api/src/infra/storage.py) does NOT survive
# a container restart/redeploy and isn't shared between the api and
# ingestion-worker containers in production the way it accidentally is
# during local dev (both processes on the same machine) — see that file's
# own docstring. No object-storage client is in the agreed stack yet
# (CLAUDE.md §3), so this is a known, explicitly-flagged gap this compose
# file does NOT solve — see docker-compose.prod.yml's own header comment
# and docs/DECISIONS_LOG.md.
UPLOAD_DIR=/app/data/uploads
