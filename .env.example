# Aegis Intelligence — environment variables
# Copy to .env and fill in real values. .env is gitignored; this file is not
# and must never contain real secrets — placeholders only.

# --- Postgres ---
# DATABASE_URL must match the postgres service in docker-compose.yml
# (user/password/db below, host "localhost" outside Docker, port 5432).
DATABASE_URL=postgresql+psycopg2://changeme:changeme@localhost:5432/aegis
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aegis

# --- Qdrant (vector store) ---
# Host ports are 6335 (REST) and 6336 (gRPC), not Qdrant's defaults 6333/
# 6334 - see docker-compose.yml comments and docs/DECISIONS_LOG.md (local
# host-port collision).
QDRANT_URL=http://localhost:6335
QDRANT_GRPC_URL=http://localhost:6336
# Collection name Phase 5's qdrant_writer.py creates/writes to. Only set
# this to point at a different collection (e.g. a second one for testing).
# QDRANT_COLLECTION=document_chunks

# --- Redis (Celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (Phase 4) ---
# Comma-separated origins the browser-facing frontend is allowed to call
# this API from. Defaults (in code, src/main.py) already cover Vite's
# default dev port (5173) -- only set this if the frontend runs somewhere
# else (a different --port, a deployed origin, etc.).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Local file storage (Phase 4) ---
# Where services/api writes uploaded PDFs and services/ingestion (Phase 5)
# reads them from -- local-disk only, not S3/blob storage (not in the
# agreed stack yet). Defaults to <repo root>/data/uploads if unset; only
# set this to point somewhere else. See services/api/src/infra/storage.py.
# UPLOAD_DIR=D:\Financial Research Intelligence Platform\data\uploads

# --- Cohere (rerank + Phase 5 embeddings + Phase 6 query-time embedding) ---
# Same key, same vendor, three uses -- see docs/DECISIONS_LOG.md's Phase 5
# embedder.py entry for why embeddings reuse Cohere instead of adding a
# new vendor. COHERE_EMBED_MODEL defaults to embed-english-v3.0 in code
# (services/ingestion/src/embedding/embedder.py and, new in Phase 6,
# services/api/src/core/dense_retriever.py -- same model name, both
# services, so query embeddings and stored chunk embeddings stay in the
# same vector space). COHERE_RERANK_MODEL (new in Phase 6, services/api/
# src/core/reranker.py) defaults to rerank-v3.5. Unlike OPENAI_API_KEY,
# this key is effectively required, not gracefully optional -- there is
# no meaningful dense retrieval without a query embedding (only rerank
# alone degrades gracefully if this is unset/fails).
COHERE_API_KEY=changeme
# COHERE_EMBED_MODEL=embed-english-v3.0
# COHERE_RERANK_MODEL=rerank-v3.5

# --- OpenAI (Phase 5 agentic chunking; Phase 6 query pipeline) ---
# Same key, two services: services/ingestion/src/chunking/agentic_chunker.py
# (Phase 5, LLM-assisted narrative section-boundary detection) and, new in
# Phase 6, services/api/src/core/{multi_query,history_manager,
# answer_generator}.py (query expansion, follow-up reformulation, grounded
# answer generation -- see docs/DECISIONS_LOG.md's Phase 6 vendor-decision
# entry for why this reuses OpenAI rather than adding a third vendor).
# Optional everywhere it's used: if unset, ingestion falls back to a
# deterministic heuristic, and the query pipeline falls back to
# skip-expansion / skip-reformulation / an extractive (non-LLM) answer --
# nothing in this project hard-fails on a missing key. OPENAI_CHUNKING_MODEL
# and OPENAI_CHAT_MODEL both default to gpt-4o-mini in code; only set these
# to override.
OPENAI_API_KEY=changeme
# OPENAI_CHUNKING_MODEL=gpt-4o-mini
# OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Embedding provider (resolved in Phase 5 -- see COHERE_API_KEY above) ---
# EMBEDDING_API_KEY is no longer used; kept out of this file rather than
# left as a stale placeholder now that the Cohere decision above replaces
# it (docs/DECISIONS_LOG.md's Phase 5 entry has the full history).

# --- LangSmith tracing (Phase 8 -- services/api/src/observability/tracing.py) ---
# Standard LangSmith env var names (read directly by both this project's
# traced_stage() decorator and the langsmith SDK itself) -- optional
# everywhere: LANGCHAIN_TRACING_V2 defaults to false, and every core/
# pipeline stage traced_stage() wraps runs identically with or without
# these set (see tracing.py's docstring -- disabled means a true no-op,
# not a thinner wrapper). Get a free API key at https://smith.langchain.com.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=changeme
# LANGCHAIN_PROJECT=aegis-intelligence

# --- Eval harness (Phase 8 -- eval/ragas_runner.py) ---
# No new key needed for RAGAS's LLM-judged faithfulness/context_precision
# scoring -- it reuses OPENAI_API_KEY above (same reasoning as Phase 6's
# vendor-reuse decision for multi_query.py/answer_generator.py). Optional:
# if OPENAI_API_KEY is unset, the eval harness falls back to deterministic
# (non-LLM-judged) scoring rather than failing -- see ragas_runner.py's
# module docstring.
# EVAL_API_URL=http://localhost:8000
# EVAL_FAIL_UNDER=0.5
