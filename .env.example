# Aegis Intelligence — environment variables
# Copy to .env and fill in real values. .env is gitignored; this file is not
# and must never contain real secrets — placeholders only.

# --- Postgres ---
# DATABASE_URL must match the postgres service in docker-compose.yml
# (user/password/db below, host "localhost" outside Docker, port 5432).
DATABASE_URL=postgresql+psycopg2://changeme:changeme@localhost:5432/aegis
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aegis

# --- Qdrant (vector store) ---
# Host ports are 6335 (REST) and 6336 (gRPC), not Qdrant's defaults 6333/
# 6334 - see docker-compose.yml comments and docs/DECISIONS_LOG.md (local
# host-port collision).
QDRANT_URL=http://localhost:6335
QDRANT_GRPC_URL=http://localhost:6336
# Collection name Phase 5's qdrant_writer.py creates/writes to. Only set
# this to point at a different collection (e.g. a second one for testing).
# QDRANT_COLLECTION=document_chunks

# --- Redis (Celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (Phase 4) ---
# Comma-separated origins the browser-facing frontend is allowed to call
# this API from. Defaults (in code, src/main.py) already cover Vite's
# default dev port (5173) -- only set this if the frontend runs somewhere
# else (a different --port, a deployed origin, etc.).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Local file storage (Phase 4) ---
# Where services/api writes uploaded PDFs and services/ingestion (Phase 5)
# reads them from -- local-disk only, not S3/blob storage (not in the
# agreed stack yet). Defaults to <repo root>/data/uploads if unset; only
# set this to point somewhere else. See services/api/src/infra/storage.py.
# UPLOAD_DIR=D:\Financial Research Intelligence Platform\data\uploads

# --- Cohere (rerank + Phase 5 embeddings) ---
# Same key, same vendor, two uses -- see docs/DECISIONS_LOG.md's Phase 5
# embedder.py entry for why embeddings reuse Cohere instead of adding a
# new vendor. COHERE_EMBED_MODEL defaults to embed-english-v3.0 in code
# (services/ingestion/src/embedding/embedder.py); only set this to
# override.
COHERE_API_KEY=changeme
# COHERE_EMBED_MODEL=embed-english-v3.0

# --- OpenAI (Phase 5 agentic chunking) ---
# Used only by services/ingestion/src/chunking/agentic_chunker.py for
# LLM-assisted narrative section-boundary detection. Optional: if unset,
# ingestion falls back to a deterministic paragraph-boundary heuristic
# instead of failing -- see that file's docstring. OPENAI_CHUNKING_MODEL
# defaults to gpt-4o-mini in code; only set this to override.
OPENAI_API_KEY=changeme
# OPENAI_CHUNKING_MODEL=gpt-4o-mini

# --- Embedding provider (resolved in Phase 5 -- see COHERE_API_KEY above) ---
# EMBEDDING_API_KEY is no longer used; kept out of this file rather than
# left as a stale placeholder now that the Cohere decision above replaces
# it (docs/DECISIONS_LOG.md's Phase 5 entry has the full history).
